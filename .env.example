# Локальна розробка (manage.py завантажує .env через python-dotenv)
DJANGO_SETTINGS_MODULE=project.settings.develop
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

DATABASE_URL=sqlite:///db.sqlite3

# Resend — https://resend.com/api-keys (HTTP API, не SMTP)
RESEND_API_KEY=re_xxxxxxxx
# Адреса з верифікованого домену в Resend
DEFAULT_FROM_EMAIL=noreply@your-domain.com
# Резервний отримувач, якщо в адмінці не задано email для сповіщень
CONTACT_RECIPIENT=your.psy@gmail.com

SECURE_SSL_REDIRECT=False

# --- Render (production) ---
# DJANGO_SETTINGS_MODULE=project.settings.production
# DEBUG=False
# SECURE_SSL_REDIRECT=True
# DATABASE_URL — з Blueprint (render.yaml) або Internal Database URL у Dashboard
# RENDER_EXTERNAL_HOSTNAME / RENDER_EXTERNAL_URL — інжектуються Render автоматично
# Власний домен (додатково до onrender.com):
# ALLOWED_HOSTS=www.example.com,example.com
# CSRF_TRUSTED_ORIGINS=https://www.example.com,https://example.com
# Деплой: Dashboard → Blueprints → New Blueprint Instance → репозиторій → Apply
